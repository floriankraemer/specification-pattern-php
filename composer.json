{
    "name": "phauthentic/specification-pattern",
    "description": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.62",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Phauthentic\\Specification\\": "src/",
            "Phauthentic\\Specification\\Examples\\ECommerce\\": "examples/ECommerce/",
            "Phauthentic\\Specification\\Examples\\OpenItemAccounting\\": "examples/OpenItemAccounting/",
            "Phauthentic\\Specification\\Examples\\OpenItemAccountingGerman\\": "examples/OpenItemAccountingGerman/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phauthentic\\Specification\\Test\\": "tests/Test/",
            "Phauthentic\\Specification\\Test\\Specifications\\": "tests/Specifications/"
        }
    },
    "authors": [
        {
            "name": "Florian Krämer"
        }
    ],
    "scripts": {
    },
    "config": {
        "sort-packages": true,
        "bin-dir": "bin"
    }
}
